# Confirmación de asistencia — variables privadas del servidor.
#
# Ninguna lleva el prefijo VITE_ a propósito: eso las publicaría en el paquete
# que descarga el navegador. Estas solo existen en la función serverless.
#
# En local: copiar este archivo a .env y rellenarlo (.env está en .gitignore).
# En Vercel: Project Settings → Environment Variables.

# Clave de la API de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Dirección donde quieres recibir las confirmaciones
RSVP_TO_EMAIL=

# Remitente. Debe pertenecer a un dominio verificado en Resend.
# Para probar sin dominio propio sirve: onboarding@resend.dev
RSVP_FROM_EMAIL=

# Copia opcional. Dejar vacío si no hace falta.
RSVP_CC_EMAIL=
